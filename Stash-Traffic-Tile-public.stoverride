name: "📊 JMS 剩余流量"
desc: "展示 JMS 套餐总额、已用、剩余、剩余比例及每月重置日。GB 按十进制换算；每 5 分钟查询。请在 Stash 脚本存储数据中设置 jms.bandwidth.api，勿把个人查询链接上传到公开仓库。"
tiles:
  - name: jms-bandwidth-tile
    interval: 300
    title: "JMS 套餐剩余流量"
    content: "等待查询；请先设置本地 API 地址"
    icon: "chart.pie.fill"
    backgroundColor: "#1685D1"
    collapsed: false
script-providers:
  jms-bandwidth-tile:
    payload: |
      // Set jms.bandwidth.api in Stash Script Stored Data. Never publish the URL.
      function gb(n) { return (n / 1000000000).toFixed(3) + ' GB'; }
      function finish(title, content, color) {
        $done({title: title, content: content, icon: 'chart.pie.fill', backgroundColor: color || '#1685D1'});
      }
      var api = $persistentStore.read('jms.bandwidth.api');
      if (!api) {
        finish('JMS · 待设置', '请在脚本存储数据中添加\njms.bandwidth.api\n值为官方 Bandwidth Counter 完整地址');
      } else if (!/^https:\/\/[^\s]+$/i.test(api.trim())) {
        finish('JMS · 地址格式错误', '请填写完整的 HTTPS 流量查询地址。');
      } else {
        $httpClient.get({url: api.trim(), timeout: 5, 'auto-redirect': false}, function(error, response, body) {
          if (error) { finish('JMS · 查询失败', '无法连接查询接口，请稍后刷新。'); return; }
          try {
            var status = Number(response && (response.status || response.statusCode));
            if (status && (status < 200 || status >= 300)) throw new Error('HTTP');
            var d = JSON.parse(body);
            if (typeof d.monthly_bw_limit_b !== 'number' || typeof d.bw_counter_b !== 'number') throw new Error('fields');
            var total = d.monthly_bw_limit_b, used = d.bw_counter_b;
            if (!isFinite(total) || !isFinite(used) || total <= 0 || used < 0) throw new Error('values');
            var left = Math.max(0, total - used), percent = left / total * 100;
            var day = Number(d.bw_reset_day_of_month);
            var text = '剩余 ' + gb(left) + '（' + percent.toFixed(2) + '%）';
            text += '\n已用 ' + gb(used) + ' / 总额 ' + gb(total);
            if (used > total) text += '\n超额 ' + gb(used - total);
            if (Number.isInteger(day) && day >= 1 && day <= 31) text += '\n流量重置：每月 ' + day + ' 日';
            text += '\n剩余精确值：' + String(left) + ' 字节';
            text += '\n更新：' + new Date().toLocaleString();
            finish('JMS 套餐剩余流量', text, percent < 10 ? '#D9534F' : '#1685D1');
          } catch (_) {
            finish('JMS · 查询失败', '接口未返回有效套餐数据。请检查本地保存的官方 API 地址。');
          }
        });
      }
